#!/usr/bin/env bash

set -e

# 1. знайти файл *.version (перший знайдений)
VERSION_FILE=$(find . -maxdepth 1 -name "*.version" | head -n 1)

if [ -z "$VERSION_FILE" ]; then
  echo "No .version file found"
  exit 0
fi

# 2. отримати ім'я без розширення
FILENAME=$(basename "$VERSION_FILE")
VERSION="${FILENAME%.*}"

echo "Detected version: $VERSION"

# 3. перевірити шаблон
TEMPLATE="readme/template.md"

if [ ! -f "$TEMPLATE" ]; then
  echo "Template not found: $TEMPLATE"
  exit 1
fi

# 4 + 5. заміна і запис README.md
sed "s/%VERSION%/$VERSION/g" "$TEMPLATE" > README.md

echo "README.md updated"